FROM golang:1.26.4@sha256:792443b89f65105abba56b9bd5e97f680a80074ac62fc844a584212f8c8102c3 as builder
ENV APP_ROOT=/opt/app-root
ENV GOPATH=$APP_ROOT

WORKDIR $APP_ROOT/src/
ADD go.mod go.sum $APP_ROOT/src/
RUN go mod download

ADD ./cmd/ $APP_ROOT/src/cmd/
ADD ./pkg/ $APP_ROOT/src/pkg/
ADD ./internal/ $APP_ROOT/src/internal/
ADD ./targets/ $APP_ROOT/src/targets/

RUN CGO_ENABLED=0 go build -o rekor_watch ./cmd/rekor_watch
RUN mkdir -p /data && chown nobody:nogroup /data

FROM gcr.io/distroless/static-debian12:nonroot AS deploy
COPY --from=builder /opt/app-root/src/rekor_watch /usr/local/bin/rekor_watch
# The monitor config is not published by TUF yet, so the local copies are
# shipped in the image; override this to select a different deployment.
COPY --from=builder /opt/app-root/src/targets/ /etc/rekor-watch/targets/
ENV REKOR_WATCH_MONITOR_CONFIG=/etc/rekor-watch/targets/staging/monitor_config.json
COPY --from=builder --chown=nonroot:nonroot /data /data
CMD ["rekor_watch"]
