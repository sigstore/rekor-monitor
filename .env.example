# Rekor Watch Configuration
# Copy this file to .env and adjust values for your deployment.
# All values shown are the defaults used when not set.

# =============================================================================
# Core Settings
# =============================================================================

# How often we check the log for consistency and monitored values
# REKOR_WATCH_INTERVAL=30s

# Base URL for the web UI (used in magic link emails)
# REKOR_WATCH_BASE_URL=http://localhost:8080

# Monitor configuration listing the Rekor logs to follow
# REKOR_WATCH_MONITOR_CONFIG=/etc/rekor-watch/targets/staging/monitor_config.json

# =============================================================================
# Web Server
# =============================================================================

# Host port to publish the web UI on
# REKOR_WATCH_HOST_PORT=8080

# Host address to bind the published port to (set to the external IP to expose externally)
# REKOR_WATCH_LISTEN=127.0.0.1

# =============================================================================
# SMTP (Email)
# =============================================================================

# SMTP server hostname (default points to the bundled mailpit service)
# REKOR_WATCH_SMTP_HOST=mailpit

# SMTP server port
# REKOR_WATCH_SMTP_PORT=1025

# Sender address for outgoing emails
# REKOR_WATCH_SMTP_FROM=rekor-watch@localhost

# SMTP authentication (leave empty for unauthenticated local relay)
# REKOR_WATCH_SMTP_USERNAME=
# REKOR_WATCH_SMTP_PASSWORD=

# Enable TLS for SMTP connection
# REKOR_WATCH_SMTP_USE_TLS=false

# SMTP HELO domain
# REKOR_WATCH_SMTP_HELO=rekor-watch.sigstore.org

# SMTP auth type: PLAIN or XOAUTH2
# REKOR_WATCH_SMTP_AUTH_TYPE=PLAIN

# =============================================================================
# Security
# =============================================================================

# Allow webhooks to private/internal IPs (SSRF protection bypass).
# Defaults to 0 (protected). Set to 1 ONLY for local development.
# REKOR_WATCH_ALLOW_PRIVATE_WEBHOOKS=0

# Trust X-Forwarded-For / X-Real-IP headers (enable behind a reverse proxy)
# REKOR_WATCH_TRUST_PROXY_HEADERS=false

# Rate limiting
# REKOR_WATCH_RATE_LIMIT_ENABLED=true
# REKOR_WATCH_RATE_LIMIT_IP_RATE=60
# REKOR_WATCH_RATE_LIMIT_IP_WINDOW=1m
# REKOR_WATCH_RATE_LIMIT_LOGIN_EMAIL_RATE=20
# REKOR_WATCH_RATE_LIMIT_LOGIN_EMAIL_WINDOW=15m
# REKOR_WATCH_RATE_LIMIT_POLL_IP_RATE=100
# REKOR_WATCH_RATE_LIMIT_POLL_IP_WINDOW=1m
# REKOR_WATCH_RATE_LIMIT_AUTH_EMAIL_RATE=60
# REKOR_WATCH_RATE_LIMIT_AUTH_EMAIL_WINDOW=1m

# =============================================================================
# Limits
# =============================================================================

# Maximum subscriptions a single user may own (must be > 0)
# REKOR_WATCH_MAX_SUBSCRIPTIONS_PER_USER=20

# Maximum matches retained per subscription; older matches are evicted FIFO
# when exceeded (must be > 0)
# REKOR_WATCH_MAX_MATCHES_PER_SUBSCRIPTION=1000

# =============================================================================
# TUF & Certificates (advanced)
# =============================================================================

# TUF repository: 'default', 'staging', or a custom URL
# REKOR_WATCH_TUF_REPOSITORY=staging

# Path to trusted root file (only for custom TUF repositories)
# REKOR_WATCH_TUF_ROOT_PATH=

# Paths to CA certificate bundles (PEM format)
# REKOR_WATCH_CA_ROOTS=
# REKOR_WATCH_CA_INTERMEDIATES=

# Path to HTTPS CA certificates for the log server (PEM format)
# REKOR_WATCH_HTTPS_CHAIN=

# =============================================================================
# Mailpit (development email server)
# =============================================================================

# Host address to bind mailpit's web UI and SMTP ports
# MAILPIT_LISTEN=127.0.0.1

# Mailpit web UI port (browse captured emails)
# MAILPIT_WEB_PORT=8025

# Mailpit SMTP port
# MAILPIT_SMTP_PORT=1025
